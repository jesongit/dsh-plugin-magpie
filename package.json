{
  "name": "dsh-plugin-magpie",
  "version": "0.2.5",
  "description": "Lightweight Magpie connector for DSH: provider-grouped models, one-time-ticket native management panel and per-model quota popup",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesongit/dsh-plugin-magpie.git"
  },
  "homepage": "https://github.com/jesongit/dsh-plugin-magpie#readme",
  "bugs": "https://github.com/jesongit/dsh-plugin-magpie/issues",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "magpie",
    "connector",
    "model-provider"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsc && tsdown",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-attachment": ">=0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.5",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.8.0",
    "tsdown": "^0.15.0"
  },
  "packageManager": "pnpm@11.28.5"
}
